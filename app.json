{
  "expo": {
    "name": "টালিখাতা",
    "slug": "tallykhata-offline",
    "version": "4.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#B81414"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B81414",
        "foregroundImage": "./assets/icons/ic_tally_khata_logo_reg.png"
      },
      "package": "com.progoti.tallykhata.offline"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-localization",
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ]
    ],
    "icon": "./assets/icons/ic_tally_khata_logo_reg.png"
  }
}
